<mvc:View controllerName="retologali.retoui5.controller.MainView"
   	xmlns:l="sap.ui.layout"
	xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
    <VBox class="sapUiSmallMargin">
		<f:SimpleForm id="SimpleFormToolbar"
			editable="true"
			layout="ResponsiveGridLayout"
			labelSpanXL="3"
			labelSpanL="2"
			labelSpanM="3"
			labelSpanS="8"
			adjustLabelSpan="false"
			emptySpanXL="0"
			emptySpanL="4"
			emptySpanM="0"
			emptySpanS="0"
			columnsXL="2"
			columnsL="1"
			columnsM="1"
			singleContainerFullSize="false"
			ariaLabelledBy="Title1" >
			
			<f:content>
				<Toolbar ariaLabelledBy="Title2">
					<Title id="Title2" text="{i18n>pinfo}"/>
					<ToolbarSpacer />
				</Toolbar>
				<Label text="ID" />
				<Input id="userid" type="Number" required="true"/>
				<Label text="Type Document" />
				<Select id="typedoc" selectedKey="{modeluser/form/typedoc}">
					<items>
						<core:Item text="DNI" key="DNI"/>
						<core:Item text="TIE" key="TIE"/>
						<core:Item text="Passport" key="Passport"/>
					</items>
				</Select>
				<Label text="Number Document" />
				<Input id="docnumber" value="{modeluser/docnumber}" required="true" />
				<Label text="First Name." />
				<Input id="firsname" value="{form/firsname}" required="true"/>
				<Label text="Last Name." />
				<Input id="lastname" value="{modeluser/form/lastname}" required="true"/>
				<!-- <Label text="Date" />
				<DatePicker value="{
				path: 'modeluser/form/bdate',
				type: 'DateType'}" />	 -->				
				
				<Toolbar ariaLabelledBy="Title3">
					<Title id="Title3" text="{i18n>otherinfo}"/>
					<ToolbarSpacer />
				</Toolbar>
				<Label text="Place Birth" />
				<Input id="pbirth" value="{modeluser/form/pbirth}" required="true" />
				<Label text="Nationality" />
				<Select id="nationalitySelect"
       					selectedKey="{modeluser/form/nationality}"
        				items="{countryModel>/countries}"
						required="true">
    			<core:Item key="{countryModel>code}" text="{countryModel>name}" />
				</Select>
								
				<Label text="Genre" />
				<Select id="generoSelect"
       					selectedKey="{modeluser/form/country}"
        				items="{countryModel>/genero}" required="true">
    			<core:Item key="{countryModel>code}" text="{countryModel>name}" />
				</Select>
				<Label text="Civil Status" />
                 <Select id="civilstatusSelect"
       					selectedKey="{modeluser/form/country}"
        				items="{countryModel>/civilstatus}"
						required="true">
    			<core:Item key="{countryModel>code}" text="{countryModel>name}" />
				</Select>
				

				<Toolbar ariaLabelledBy="Title4">
					<Title id="Title4" text="{i18n>addressinfo}"/>
					<ToolbarSpacer />
				</Toolbar>
				<Label text="Country" />
				<Select id="countrySelect"
       					selectedKey="{modeluser/form/country}"
        				change=".onCountryChange"
        				items="{countryModel>/countries}"
						required="true">
    			<core:Item key="{countryModel>code}" text="{countryModel>name}" />
				</Select>
				
				<Label text="Province" />
				<Select id="provinceSelect"
        				selectedKey="{modeluser/form/province}" 
						required="true">
					<items>
						<!-- Llenado dinámico desde el controlador -->
					</items>
				</Select>
				<!-- <Label text="Region" />-->
				<!-- <Input id="region" value="{modeluser/form/region}"  required="true"/>-->
				<Label text="Address" />
				<Input id="address" value="{modeluser/form/address}" required="true"/>
				<Label text="Postal code" />
				<Input id="pcode" value="{modeluser/form/pcode}" required="true"/>
				<Toolbar ariaLabelledBy="Title5">
					<Title id="Title5" text="{i18n>contactinfo}"/>
					<ToolbarSpacer />
				</Toolbar>
				<Label text="Phone Number" />
				<Input id="phonenumber" value="{modeluser/form/phonenumber}" type="Url" required="true"/>
				<Label text="Email" />
				<Input id="email" value="{modeluser/form/email}" required="true" />
			</f:content>
		</f:SimpleForm>
	</VBox>
		<Panel id="_IDGenPaneltable">
			<Table 	id="idProductsTable"
					inset="false"
					items="{
			path: 'modeluser>/users',
			sorter: {
				path: 'userid'
			}
		}">
		<headerToolbar>
			<OverflowToolbar>
				<content>
					<Title text="Usuarios" level="H2"/>
					
				</content>
			</OverflowToolbar>
		</headerToolbar>
		<infoToolbar>
			<OverflowToolbar>
				<Label text="Usuarios inscritos en el curso SAPUi5"/>
			</OverflowToolbar>
		</infoToolbar>
		<columns>
			<Column>
				<Text text="Number document" />
			</Column>
			<Column>
				<Text text="First Name" />
			</Column>
			<Column>
				<Text text="Last Name" />
			</Column>
			<Column>
				<Text text="Place birth" />
			</Column>
			<Column>
				<Text text="Nationality" />
			</Column>
			<Column>
				<Text text="Genre" />
			</Column>
			<Column>
				<Text text="Civil status" />
			</Column>
		</columns>
		<items>
			<ColumnListItem vAlign="Middle">
				<cells>
					<ObjectIdentifier
						title="{modeluser>userid}"
						text="{modeluser>lastname}"/>
					<Text text="{modeluser>firsname}"/>
					<Text text="{modeluser>lastname}"/>
					<Text text="{modeluser>pbirth}"/>
					<Text text="{modeluser>nationality}"/>
					<Text text="{modeluser>genre}"/>
					<Text text="{modeluser>civilstatus}"/>
					
				</cells>
			</ColumnListItem>
		</items>
	</Table>
			</Panel>
		<footer>
			<Bar id="_IDGenBar">
				<contentRight>
					<Button id="_IDGenButton" type="Accept" text="Save" press="onSave">
					<layoutData><OverflowToolbarLayoutData id="_IDGenOverflowToolbarLayoutData1" priority="NeverOverflow" /></layoutData>
				</Button>
				<Button id="_IDGenButton1" type="Neutral" text="Clear" press="clearForm">
					<layoutData><OverflowToolbarLayoutData id="_IDGenOverflowToolbarLayoutData" priority="NeverOverflow" /></layoutData>
				</Button>
				</contentRight>
			</Bar>
		</footer>
    </Page>
	
	
</mvc:View>